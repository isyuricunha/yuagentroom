# --- Server ---
PORT=3000

# --- Database ---
# SQLite (default, simplest for getting started)
DATABASE_URL=sqlite:./data/db.sqlite

# PostgreSQL (optional, uncomment and use with db service)
# DATABASE_URL=postgresql://yuagentroom:change_me_yuagentroom_password@db:5432/yuagentroom

# --- Security ---
# Master password for Web UI login (leave empty for open mode without auth)
ADMIN_PASSWORD=change_me_password

# Secret for signing JWT tokens (generate a long random string in production)
JWT_SECRET=change_me_in_production

# --- Optional ---
# Redis connection for pub/sub (enables multi-instance scaling)
# REDIS_URL=redis://redis:6379