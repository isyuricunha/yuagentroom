# --- Server ---
# The port the API and Web interface will be served on
PORT=3000

# --- Security ---
# JWT secret for signing JWT tokens (generate a long random string)
JWT_SECRET=super_secret_jwt_key_example
# Allow user registration (set to 'true' to enable signup via UI)
ALLOW_REGISTRATION=false

# --- Default User ---
# On first startup, a default admin user is automatically created:
#   Username: admin
#   Password: admin123
# Users must change their password on first login.
# The admin can then create additional users from the admin panel.

# --- Web UI ---
# URL where the frontend expects the backend to be hosted
# VITE_API_URL=http://localhost:3000

# --- Database ---
# For SQLite (default, data is saved to a local db.sqlite file)
DATABASE_URL=sqlite:./data/db.sqlite

# For PostgreSQL (uncomment and replace with your DB URL)
# DATABASE_URL=postgresql://user:password@hostname:5432/agentroom

# --- Optional caching / multi-instance scaling ---
# REDIS_URL=redis://localhost:6379