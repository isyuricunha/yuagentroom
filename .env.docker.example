# --- Server ---
PORT=3000

# --- Database ---
# SQLite (default, simplest for getting started)
DATABASE_URL=sqlite:./data/db.sqlite

# PostgreSQL (optional, uncomment and use with db service)
# DATABASE_URL=postgresql://yuagentroom:change_me_yuagentroom_password@db:5432/yuagentroom

# --- Security ---
# Secret for signing JWT tokens (generate a long random string in production)
JWT_SECRET=change_me_in_production
# Allow user registration (set to 'true' to enable signup via UI)
ALLOW_REGISTRATION=false

# --- Optional Admin Configuration ---
# Set a default admin password on first startup (optional)
# ADMIN_PASSWORD=your_secure_password

# --- Default User ---
# On first startup, a default admin user is automatically created:
#   Username: admin
#   Password: admin123
# Users must change their password on first login.

# --- Optional ---
# Redis connection for pub/sub (enables multi-instance scaling)
# REDIS_URL=redis://redis:6379